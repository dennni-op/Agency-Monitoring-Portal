{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agency-monitoring-portal",
  "compatibility_date": "2026-06-13",
  "observability": {
    "enabled": true
  },
  // Publishes the project root, but .assetsignore excludes non-public files
  // (app source, client configs, secrets) so only index.html and docs/ ship.
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
